[Unit]
Description=Create a read-only Polybot 24-hour operational report
After=polybot-observer.service

[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory=/opt/polybot
EnvironmentFile=/etc/polybot/polybot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/polybot/.venv/bin/python /opt/polybot/scripts/operational-report.py --database /var/lib/polybot/polybot.sqlite3 --state-root /var/lib/polybot --ecmwf-json-root /var/lib/polybot/forecasts/ecmwf-ifs025-json --weathernext-full-root /var/lib/polybot/weathernext/full --weathernext-statistics-snapshot /var/lib/polybot/weathernext-statistics-snapshot.json --hours 24 --output /var/lib/polybot/reports/operational-24h.json --json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/polybot/reports
