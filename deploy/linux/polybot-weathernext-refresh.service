[Unit]
Description=Polybot metadata-only WeatherNext first-full-trial planner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/polybot/polybot.sqlite3
ConditionPathExists=/etc/polybot/polybot.env
ConditionPathExists=/var/lib/polybot/.config/gcloud/application_default_credentials.json

[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory=/opt/polybot
EnvironmentFile=/etc/polybot/polybot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/polybot/.venv/bin/polybot weathernext first-full-trial-plan \
  --database /var/lib/polybot/polybot.sqlite3 \
  --root /var/lib/polybot/weathernext/full \
  --probe-result /var/lib/polybot/weathernext/full/probe-result.json \
  --json
Nice=15
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=15
IOWeight=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/polybot
